; WILDRUSH — Godot 4.7 project. See docs/DECISIONS.md.

config_version=5

[application]

config/name="WILDRUSH"
config/description="Five animals. One pack. A 5v5 third-person animal arena fighter."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="WILDRUSH"
run/max_fps=0
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.055, 0.06, 0.07, 1)
boot_splash/show_image=false

[autoload]

Config="*res://src/core/config.gd"
Tuning="*res://src/data/tuning_db.gd"
Settings="*res://src/persist/settings.gd"
Profile="*res://src/persist/profile.gd"
Net="*res://src/net/net_bridge.gd"
Online="*res://src/online/online_client.gd"
AudioDirector="*res://src/present/audio_director.gd"
Game="*res://src/core/game_flow.gd"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"
driver/output_latency=30

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
settings/stdout/print_fps=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

theme/custom="res://assets/ui/wildrush_theme.tres"
theme/default_font_multichannel_signed_distance_field=false
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighters"
3d_physics/layer_3="blocker_team0_spawn"
3d_physics/layer_4="blocker_team1_spawn"
3d_physics/layer_5="water_blocker"
3d_physics/layer_6="camera_block"
3d_physics/layer_7="perch"

[network]

limits/debugger/max_chars_per_second=32768

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
shadows/directional_shadow/size=4096
shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.07, 1)
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=1.5
