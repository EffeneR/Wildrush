{
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes",
        "sparsePaths": [
          ".claude-plugin",
          "skills"
        ]
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  },
  "env": {
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hyperframes-env.sh"
          }
        ]
      }
    ]
  }
}
