# WILDRUSH control service configuration template — PLACEHOLDERS ONLY, no secrets.
# Copy to services/.env (git-ignored) and edit. Used by deploy/docker-compose.yml
# (`--env-file ../.env`) and, for native runs, by `set -a; source services/.env; set +a`.
# Secrets never go here in the compose deployment: the database password is the Docker
# secret deploy/secrets/pg_password.txt; server secrets come from `admin add-server`.

# --- public endpoint (compose + Caddy) ------------------------------------------------------
WR_DOMAIN=wildrush.example.org
# 127.0.0.1 keeps Caddy private. Use 0.0.0.0 only when you intend to expose TCP 80/443.
WR_HTTP_BIND=127.0.0.1
WR_PUBLIC_BASE_URL=https://wildrush.example.org

# --- service tuning (defaults shown; all optional) ---------------------------------------
# WR_TICKET_TTL_S=60
# WR_SESSION_TTL_H=12
# WR_INVITE_TTL_S=300
# WR_MATCHMAKER_INTERVAL_S=1
# WR_SERVER_STALE_S=30
# WR_ALLOCATION_TIMEOUT_S=45
# WR_PRIVATE_ALLOC_WAIT_S=20
# WR_PROTOCOL_VERSION=1
# WR_SERVICE_BUILD=1.0.0
# WR_LOG_LEVEL=info
# WR_DEV_ALLOW_HTTP=false        # never true on a public host

# --- native (non-container) runs only ----------------------------------------------------------
# WR_DATABASE_URL=postgresql+psycopg://wildrush@127.0.0.1:5432/wildrush
# WR_DATABASE_PASSWORD_FILE=/etc/wildrush/pg_password     # mode 0600, owned by the service user
# WR_BIND=127.0.0.1:8080                                   # keep loopback; put Caddy in front
# WR_FORWARDED_ALLOW_IPS=127.0.0.1                          # the reverse proxy address

# --- optional allocator container on a game-server host (deploy/allocator.compose.yml) ----------
# WR_ALLOCATOR_SERVER_ID=eu-1
# WR_ALLOCATOR_REGION=eu
# WR_ALLOCATOR_PUBLIC_HOST=game-eu-1.example.org
# WR_ALLOCATOR_MAX_MATCHES=4
# WR_SERVER_EXPORT_DIR=/srv/wildrush/server-export
# WR_SERVER_BINARY_NAME=wildrush_server.x86_64
# WR_SERVER_EXTRA_ARGS_JSON=[]
# WR_BUILD_ID=1.0.0
